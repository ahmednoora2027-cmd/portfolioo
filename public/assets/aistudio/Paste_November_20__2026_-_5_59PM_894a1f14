            <ul class="space-y-2">
              ${current.steps.map((step, idx) => `
                <li class="flex items-start gap-2.5 text-sm text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 p-3 rounded-xl">
                  <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">${idx + 1}</span>
                  <span>${step}</span>
                </li>
              `).join('')}
            </ul>
          </div>
        `;

        btnsEl.querySelectorAll('.issue-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            activeIssueId = btn.getAttribute('data-issue-id');
            renderTroubleshooter();
          });
        });

        if (window.lucide) window.lucide.createIcons();
      }

      document.getElementById('requestTroubleshootBtn').addEventListener('click', () => {
        const current = windowsIssues.find((i) => i.id === activeIssueId) || windowsIssues[0];
        const selectEl = document.getElementById('serviceType');
        const msgEl = document.getElementById('clientMessage');
        selectEl.value = 'دعم فني وحل مشاكل الويندوز أونلاين';
        msgEl.value = 'أحتاج مساعدة أونلاين بخصوص: ' + current.title;
        document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
        msgEl.focus();
      });

      // Service card quick-select
      document.querySelectorAll('.select-service-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const service = btn.getAttribute('data-select-service');
          document.getElementById('serviceType').value = service;
          document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
          document.getElementById('clientName').focus();
        });
      });

      // Form & Modal
      const confirmModal = document.getElementById('confirmModal');
      const formError = document.getElementById('formError');

      function closeModal() {
        confirmModal.classList.add('hidden');
      }

      document.getElementById('closeModalBtn').addEventListener('click', closeModal);
      document.getElementById('doneModalBtn').addEventListener('click', closeModal);
      confirmModal.addEventListener('click', (e) => {
        if (e.target === confirmModal) closeModal();
      });

      document.getElementById('contactForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('clientName').value.trim();
        const contact = document.getElementById('clientContact').value.trim();
        const service = document.getElementById('serviceType').value;
        const message = document.getElementById('clientMessage').value.trim();

        if (!name || !contact || !message) {
          formError.textContent = 'يرجى ملء الاسم، وسيلة التواصل، وتفاصيل الطلب قبل المتابعة.';
          formError.classList.remove('hidden');
          return;
        }
        formError.classList.add('hidden');

        lastRequestText = `طلب خدمة لأحمد عماد الدين جمال\nالاسم: ${name}\nالتواصل: ${contact}\nالخدمة: ${service}\nالتفاصيل: ${message}`;
        document.getElementById('whatsappSendBtn').href = 'https://wa.me/201013835847?text=' + encodeURIComponent(lastRequestText);

        document.getElementById('modalSummary').innerHTML = `
          <p><strong>الاسم:</strong> ${name}</p>
          <p><strong>وسيلة التواصل:</strong> ${contact}</p>
          <p><strong>الخدمة:</strong> ${service}</p>
          <p><strong>التفاصيل:</strong> ${message}</p>
        `;
        document.getElementById('copyBtnText').textContent = 'نسخ تفاصيل الطلب';
        confirmModal.classList.remove('hidden');
        e.target.reset();
      });

      document.getElementById('copySummaryBtn').addEventListener('click', () => {
        if (!lastRequestText) return;
        const btnText = document.getElementById('copyBtnText');
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(lastRequestText).then(() => {
            btnText.textContent = 'تم النسخ!';
          }).catch(() => fallbackCopy(lastRequestText, btnText));
        } else {
          fallbackCopy(lastRequestText, btnText);
        }
      });

      function fallbackCopy(text, labelEl) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          labelEl.textContent = 'تم النسخ!';
        } catch (err) {
          labelEl.textContent = 'تعذر النسخ';
        }
        document.body.removeChild(ta);
      }

      renderSkills();
      renderTroubleshooter();
      if (window.lucide) window.lucide.createIcons();
    })();
  </script>
</body>
</html>